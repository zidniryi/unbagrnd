# Copy this file to .env and fill in at least UNBAGRND_ADMIN_KEY before
# running `docker compose up --build`. Never commit your real .env.

# --- Server ---
HOST=0.0.0.0
PORT=8080

# --- Database ---
# SQLite file path. The default matches the /data volume mounted by
# docker-compose.yml - change it only if you know what you're doing.
DATABASE_URL=sqlite:///data/unbagrnd.db

# --- Admin key ---
# Required to create/list/revoke API keys (POST/GET/DELETE /v1/keys). If
# left empty, key management is disabled entirely and the server logs a
# warning on startup - /health and any already-issued keys still work.
#
# Generate one yourself, e.g.:
#   openssl rand -hex 32
UNBAGRND_ADMIN_KEY=

# --- Model ---
# Which background-removal model to load at startup - see
# core/src/models.rs for the full catalog (silueta, u2net,
# birefnet-general-lite, u2net_human_seg, u2net_cloth_seg, isnet-anime).
# Downloaded once on first startup and cached in UNBAGRND_MODELS_DIR after
# that.
UNBAGRND_MODEL_KEY=silueta
UNBAGRND_MODELS_DIR=/models

# --- Upload limits ---
UNBAGRND_MAX_FILE_SIZE_MB=20
UNBAGRND_MAX_IMAGE_WIDTH=8192
UNBAGRND_MAX_IMAGE_HEIGHT=8192

# --- Concurrency & rate limiting ---
# How many /v1/remove-background inferences run at once, regardless of how
# many requests are in flight.
UNBAGRND_MAX_CONCURRENT_INFERENCES=2
# Max images accepted per POST /v1/remove-background/batch request. Each
# batch item still counts toward UNBAGRND_MAX_CONCURRENT_INFERENCES, so a
# big batch queues rather than overwhelming the server.
UNBAGRND_MAX_BATCH_SIZE=10
# Per-API-key requests/minute. In-memory only - resets on restart, and 0
# disables rate limiting entirely.
UNBAGRND_RATE_LIMIT_PER_MINUTE=60

# --- CORS ---
# "*" allows any origin (fine for local development / a single trusted
# frontend). For anything exposed to the public internet, restrict this to
# a comma-separated allowlist, e.g. https://example.com,https://app.example.com
UNBAGRND_CORS_ORIGINS=*

# --- Logging ---
# Standard `tracing-subscriber` EnvFilter syntax, e.g. "info",
# "unbagrnd_api=debug,info".
RUST_LOG=info
